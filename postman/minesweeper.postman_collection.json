{
  "info": {
    "name": "Minesweeper API",
    "description": "API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/v1"
    },
    {
      "key": "gameId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create game",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rows\": 9,\n  \"columns\": 9,\n  \"mines\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/games",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "games"
          ]
        }
      }
    },
    {
      "name": "Get game",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/games/{{gameId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "games",
            "{{gameId}}"
          ]
        }
      }
    },
    {
      "name": "Reveal cell",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"row\": 0,\n  \"column\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/games/{{gameId}}/moves",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "games",
            "{{gameId}}",
            "moves"
          ]
        }
      }
    },
    {
      "name": "Flag cell",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"row\": 0,\n  \"column\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/games/{{gameId}}/flags",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "games",
            "{{gameId}}",
            "flags"
          ]
        }
      }
    }
  ]
}
